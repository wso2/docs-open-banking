{% set tabid = 1 %}
{% for config in configs %}

{% if config.title %}
## {{ config.title | safe }}
{% endif %}

<div className="mb-config-catalog">
    <section>
        <div className="mb-config-options">
            <div className="superfences-tabs">
            {% set tabid = tabid + 1 %}
            <input name="{{tabid}}" type="checkbox" id="_tab_{{tabid}}" />
                <label className="tab-selector" htmlFor="_tab_{{tabid}}"><i className="icon fa fa-code"></i></label>
                <div className="superfences-content">
                    <div className="mb-config-example">
{% set exampleToml %}{% include "../data/" + config.exampleFile %}{% endset %}<pre><code className="toml">{`{{ exampleToml | replace("\\", "\\\\") | replace("`", "\\`") | replace("${", "\\${") | safe }}`}</code></pre>
                    </div>
                </div>
                <div className="doc-wrapper">
                    <div className="mb-config">
                        {% for option in config.options %}<div className="config-wrap">
                            <code>[{{ option.name }}]</code>
                            {% if option.required %}<span className="badge-required">Required</span>{% endif %}
                            <p>
                                {{ option.description | safe }}
                            </p>
                        </div>
                        <div className="params-wrap">
                            {% for param in option.params %}<div className="param">
                                <div className="param-name">
                                  <span className="param-name-wrap"> <code>{{ param.name }}</code> </span>
                                </div>
                                <div className="param-info">
                                    <div>
                                        <p>
                                            <span className="param-type string"> {{ param.type }} </span>
                                            {% if param.required %}<span className="badge-required">Required</span>{% endif %}
                                        </p>
                                        <div className="param-default">
                                            <span className="param-default-value">Default: <code>{{ param.default }}</code></span>
                                        </div>
                                        {%if param.possible %}<div className="param-possible">
                                            <span className="param-possible-values">Possible Values: <code>{{ param.possible }}</code></span>
                                        </div>{% endif %}
                                    </div>
                                    <div className="param-description">
                                        <p>{{ param.description }}</p>
                                    </div>
                                </div>
                            </div>{% endfor %}
                        </div>{% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
{% endfor %}
